rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string
        && id.size() >= 1
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSeat(seat, color) {
      return seat == null || (
        seat is map
        && seat.keys().hasAll(['pseudo', 'color', 'confirmed', 'connected', 'lastSeenAt'])
        && seat.keys().hasOnly(['pseudo', 'color', 'confirmed', 'connected', 'lastSeenAt'])
        && seat.pseudo is string
        && seat.pseudo.size() >= 1
        && seat.pseudo.size() <= 30
        && seat.color == color
        && seat.confirmed is bool
        && seat.connected is bool
        && seat.lastSeenAt is string
      );
    }

    function isValidEngine(engine) {
      return engine is map
        && engine.keys().hasAll([
          'board', 'turn', 'ply', 'kingOnlyPlies', 'endgame16Plies',
          'endgame5Plies', 'positionCounts', 'winner', 'endReason'
        ])
        && engine.board is map
        && engine.turn in ['white', 'black']
        && engine.ply is int
        && engine.kingOnlyPlies is int
        && engine.endgame16Plies is int
        && engine.endgame5Plies is int
        && engine.positionCounts is map
        && engine.winner in ['none', 'white', 'black', 'draw']
        && engine.endReason in [
          'none', 'no_pieces', 'no_moves', 'resignation',
          'threefold_repetition', 'twenty_five_move_rule',
          'endgame_16_moves', 'endgame_5_moves', 'mutual_draw'
        ];
    }

    function isValidGame(data, gameId) {
      return data.keys().hasAll([
          'id', 'creatorColor', 'status', 'version', 'white', 'black',
          'spectatorCount', 'engine', 'moves', 'annotations', 'simulation',
          'rematchRequestedBy', 'rematchGameId', 'createdAt', 'updatedAt',
          'whiteToken', 'blackToken'
        ])
        && data.keys().hasOnly([
          'id', 'creatorColor', 'status', 'version', 'white', 'black',
          'spectatorCount', 'engine', 'moves', 'annotations', 'simulation',
          'rematchRequestedBy', 'rematchGameId', 'createdAt', 'updatedAt',
          'whiteToken', 'blackToken'
        ])
        && data.id == gameId
        && isValidId(data.id)
        && data.creatorColor in ['white', 'black']
        && data.status in ['waiting', 'confirming', 'playing', 'finished']
        && data.version is int
        && data.version >= 1
        && isValidSeat(data.white, 'white')
        && isValidSeat(data.black, 'black')
        && data.spectatorCount is int
        && isValidEngine(data.engine)
        && data.moves is list
        && data.moves.size() <= 512
        && data.annotations is map
        && data.annotations.highlights is map
        && data.annotations.arrows is list
        && data.annotations.arrows.size() <= 24
        && data.annotations.squareMarkers is map
        && data.annotations.notes is list
        && data.annotations.notes.size() <= 40
        && data.annotations.updatedBy is string
        && data.annotations.updatedAt is string
        && (
          data.simulation == null
          || (
            data.simulation is map
            && data.simulation.active is bool
            && data.simulation.shared is bool
            && data.simulation.controllerPseudo is string
            && isValidEngine(data.simulation.engine)
            && data.simulation.history is list
          )
        )
        && (
          data.rematchRequestedBy == null
          || data.rematchRequestedBy in ['white', 'black']
        )
        && (data.rematchGameId == null || isValidId(data.rematchGameId))
        && data.createdAt is string
        && data.updatedAt is string
        && (
          data.whiteToken == null
          || (data.whiteToken is string && data.whiteToken.size() <= 128)
        )
        && (
          data.blackToken == null
          || (data.blackToken is string && data.blackToken.size() <= 128)
        );
    }

    function isParticipant(data) {
      return isAuthenticated()
        && (
          data.whiteToken == request.auth.uid
          || data.blackToken == request.auth.uid
        );
    }

    function hasStableIdentity(before, after) {
      return after.id == before.id
        && after.creatorColor == before.creatorColor
        && after.whiteToken == before.whiteToken
        && after.blackToken == before.blackToken
        && after.createdAt == before.createdAt
        && after.spectatorCount == before.spectatorCount;
    }

    function isJoiningVacantWhiteSeat() {
      return resource.data.status == 'waiting'
        && resource.data.whiteToken == null
        && resource.data.blackToken != null
        && request.resource.data.whiteToken == request.auth.uid
        && request.resource.data.blackToken == resource.data.blackToken
        && request.resource.data.white != null
        && request.resource.data.black == resource.data.black
        && request.resource.data.status == 'confirming'
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'white', 'whiteToken', 'status', 'version', 'updatedAt'
        ]);
    }

    function isJoiningVacantBlackSeat() {
      return resource.data.status == 'waiting'
        && resource.data.blackToken == null
        && resource.data.whiteToken != null
        && request.resource.data.blackToken == request.auth.uid
        && request.resource.data.whiteToken == resource.data.whiteToken
        && request.resource.data.black != null
        && request.resource.data.white == resource.data.white
        && request.resource.data.status == 'confirming'
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'black', 'blackToken', 'status', 'version', 'updatedAt'
        ]);
    }

    function isParticipantUpdate() {
      return isParticipant(resource.data)
        && hasStableIdentity(resource.data, request.resource.data)
        && request.resource.data.version >= resource.data.version
        && request.resource.data.version <= resource.data.version + 1
        && (
          resource.data.status != 'finished'
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'rematchRequestedBy', 'rematchGameId', 'annotations', 'simulation',
            'version', 'updatedAt'
          ])
        );
    }

    function isInitialGame(data) {
      return data.status == 'waiting'
        && data.version == 1
        && (
          (
            data.whiteToken == request.auth.uid
            && data.white != null
            && data.blackToken == null
            && data.black == null
          )
          || (
            data.blackToken == request.auth.uid
            && data.black != null
            && data.whiteToken == null
            && data.white == null
          )
        );
    }

    function isRematchGame(data) {
      return data.status == 'playing'
        && data.version == 1
        && data.whiteToken != null
        && data.blackToken != null
        && data.white.confirmed == true
        && data.black.confirmed == true
        && isParticipant(data);
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'pseudo', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'pseudo', 'email', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.pseudo is string && data.pseudo.size() >= 1 && data.pseudo.size() <= 40
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId)
        && isVerifiedUser()
        && request.auth.uid == userId;
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerifiedUser()
        && request.auth.uid == userId
        && isValidUserProfile(request.resource.data, userId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedUser()
        && request.auth.uid == userId
        && isValidUserProfile(request.resource.data, userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pseudo', 'updatedAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /games/{gameId} {
      allow get: if isAuthenticated() && isValidId(gameId);
      allow list: if false;
      allow create: if isAuthenticated()
        && isValidGame(request.resource.data, gameId)
        && (
          isInitialGame(request.resource.data)
          || isRematchGame(request.resource.data)
        );
      allow update: if isAuthenticated()
        && isValidGame(request.resource.data, gameId)
        && (
          isJoiningVacantWhiteSeat()
          || isJoiningVacantBlackSeat()
          || isParticipantUpdate()
        );
      allow delete: if false;
    }
  }
}
