{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil privé d'un joueur authentifié avec Google.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "pseudo": { "type": "string", "maxLength": 40 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "pseudo", "email", "createdAt", "updatedAt"]
    },
    "GameSession": {
      "title": "GameSession",
      "description": "Partie complète synchronisée par les clients authentifiés.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "creatorColor": { "type": "string", "enum": ["white", "black"] },
        "status": { "type": "string", "enum": ["waiting", "confirming", "playing", "finished"] },
        "version": { "type": "integer" },
        "white": { "type": ["object", "null"] },
        "black": { "type": ["object", "null"] },
        "spectatorCount": { "type": "integer" },
        "engine": { "type": "object" },
        "moves": { "type": "array", "maxItems": 512 },
        "annotations": { "type": "object" },
        "simulation": { "type": ["object", "null"] },
        "rematchRequestedBy": { "type": ["string", "null"] },
        "rematchGameId": { "type": ["string", "null"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "whiteToken": {
          "type": ["string", "null"],
          "description": "Firebase Authentication UID for the white seat; not a secret."
        },
        "blackToken": {
          "type": ["string", "null"],
          "description": "Firebase Authentication UID for the black seat; not a secret."
        }
      },
      "required": [
        "id", "creatorColor", "status", "version", "white", "black",
        "spectatorCount", "engine", "moves", "annotations", "simulation",
        "rematchRequestedBy", "rematchGameId", "createdAt", "updatedAt",
        "whiteToken", "blackToken"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Profil utilisateur privé protégé par propriété stricte."
    },
    "/games/{gameId}": {
      "schema": { "$ref": "#/entities/GameSession" },
      "description": "Parties créées et mises à jour par leurs joueurs authentifiés."
    }
  }
}
